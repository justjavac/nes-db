{
  "name": "nes-db",
  "description": "A database of NES games, with information about their publishers, developers, release dates, and more.",
  "version": "1.2.0",
  "author": "justjavac <justjavac@gmail.com>",
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "yarn clean && tsc -m commonjs --outDir dist/cjs && node -e \"require('node:fs').renameSync('dist/cjs/nesdb.js', 'dist/cjs/nesdb.cjs')\" && tsc -m esnext --outDir dist/esm -d",
    "prepublishOnly": "yarn build",
    "fmt": "prettier --write \"src/**/*.ts\""
  },
  "keywords": [
    "nes",
    "game",
    "play",
    "database"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/justjavac/nes-db"
  },
  "main": "./dist/cjs/nesdb.cjs",
  "module": "./dist/esm/nesdb.js",
  "unpkg": "./dist/cjs/nesdb.cjs",
  "types": "./dist/esm/nesdb.d.ts",
  "exports": {
    "require": "./dist/cjs/nesdb.cjs",
    "import": "./dist/esm/nesdb.js"
  },
  "sideEffects": false,
  "type": "module",
  "files": [
    "dist"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^26.0.1",
    "prettier": "^3.9.1",
    "typescript": "^6.0.3"
  }
}
